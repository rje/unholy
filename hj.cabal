cabal-version: 3.0
name: hj
version: 0.1.0.0
synopsis: A small native Haskell 3D game engine and editor
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: assets/shaders/*.vs, assets/shaders/*.fs, native/vendor/raygui.h, native/vendor/README.md, README.md

executable hj
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: HJ.Types, HJ.JSON, HJ.Project, HJ.Native, HJ.Audio, HJ.Script, HJ.Script.API, HJ.Physics, HJ.Editor, HJ.Renderer, HJ.Renderer.GL, HJ.Renderer.Assets, HJ.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite hj-renderer-tests
  type: exitcode-stdio-1.0
  main-is: RendererSpec.hs
  hs-source-dirs: test, src
  other-modules: HJ.Types, HJ.JSON, HJ.Project, HJ.Native, HJ.Audio, HJ.Renderer, HJ.Renderer.GL, HJ.Renderer.Assets, HJ.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  if os(darwin)
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  pkgconfig-depends: raylib >=5.5
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite hj-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: RuntimeSpec, HJ.Types, HJ.JSON, HJ.Project, HJ.Native, HJ.Audio, HJ.Script, HJ.Script.API, HJ.Physics, HJ.Renderer, HJ.Renderer.GL, HJ.Renderer.Assets, HJ.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
