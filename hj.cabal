cabal-version: 3.0
name: hj
version: 0.1.0.0
synopsis: A small native Haskell 3D game engine and editor
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: assets/shaders/*.vs, assets/shaders/*.fs, native/vendor/raygui.h, native/vendor/README.md, README.md

executable hj
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: HJ.Types, HJ.JSON, HJ.Project, HJ.Native, HJ.Script, HJ.Physics, HJ.Editor
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text
  c-sources: native/hj.c, native/audio.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, lua >=5.4, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall

test-suite hj-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: HJ.Types, HJ.JSON, HJ.Project, HJ.Native, HJ.Script, HJ.Physics
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text
  c-sources: native/hj.c, native/audio.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, lua >=5.4, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall
