cabal-version: 3.0
name: threshold
version: 0.1.0.0
synopsis: A Haskell capsule traversal game using Unholy
license: MIT
build-type: Simple

executable threshold
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: Threshold
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite threshold-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: Threshold
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
