cabal-version: 3.0
name: circuit-breaker
version: 0.1.0.0
synopsis: An editable Haskell switch-and-door game using Unholy
license: MIT
build-type: Simple

executable circuit-breaker
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: CircuitBreaker
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite circuit-breaker-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: CircuitBreaker
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
