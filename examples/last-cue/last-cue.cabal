cabal-version: 3.0
name: last-cue
version: 0.1.0.0
synopsis: A two-act Haskell backstage adventure using Unholy
license: MIT
build-type: Simple

executable last-cue
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: LastCue
  build-depends: base, unholy, containers, directory, filepath, aeson
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite last-cue-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: LastCue
  build-depends: base, unholy, containers, directory, filepath, aeson
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
