cabal-version: 3.0
name: pulse-courier
version: 0.1.0.0
synopsis: A compiled Haskell game using the Unholy library
license: MIT
build-type: Simple

executable pulse-courier
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: PulseCourier
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite pulse-courier-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: PulseCourier
  build-depends: base, unholy, containers, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
