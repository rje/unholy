cabal-version: 3.0
name: unholy
version: 0.1.0.0
synopsis: A small native Haskell 3D game engine and editor
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: assets/shaders/*.vs, assets/shaders/*.fs, native/vendor/raygui.h, native/vendor/README.md, README.md

executable unholy
  main-is: Main.hs
  hs-source-dirs: src
  other-modules: Unholy.Types, Unholy.Gizmo, Unholy.Transform, Unholy.Prefab, Unholy.JSON, Unholy.Project, Unholy.Native, Unholy.Audio, Unholy.Script, Unholy.Script.API, Unholy.Physics, Unholy.Editor, Unholy.Renderer, Unholy.Renderer.GL, Unholy.Renderer.Assets, Unholy.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite unholy-renderer-tests
  type: exitcode-stdio-1.0
  main-is: RendererSpec.hs
  hs-source-dirs: test, src
  other-modules: Unholy.Types, Unholy.Gizmo, Unholy.Transform, Unholy.Prefab, Unholy.JSON, Unholy.Project, Unholy.Native, Unholy.Audio, Unholy.Renderer, Unholy.Renderer.GL, Unholy.Renderer.Assets, Unholy.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  if os(darwin)
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  pkgconfig-depends: raylib >=5.5
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite unholy-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: RuntimeSpec, FeatureSpec, Unholy.Types, Unholy.Gizmo, Unholy.Transform, Unholy.Prefab, Unholy.JSON, Unholy.Project, Unholy.Native, Unholy.Audio, Unholy.Script, Unholy.Script.API, Unholy.Physics, Unholy.Renderer, Unholy.Renderer.GL, Unholy.Renderer.Assets, Unholy.Renderer.Camera
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/lua.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
