cabal-version: 3.0
name: unholy
version: 0.1.0.0
synopsis: A native Haskell 3D game engine, library and editor
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: assets/shaders/*.vs, assets/shaders/*.fs, native/vendor/raygui.h, native/vendor/stb_image.h, native/vendor/cgltf.h, native/vendor/cgltf-LICENSE, native/vendor/README.md, test/fixtures/animation/*.gltf, test/fixtures/animation/*.bin, test/fixtures/gltf/*.gltf, test/fixtures/gltf/*.bin, test/fixtures/gltf/*.glb, test/fixtures/gltf/*.png, README.md
data-files: assets/shaders/*.vs, assets/shaders/*.fs

library
  hs-source-dirs: src
  exposed-modules: Unholy, Unholy.Authoring, Unholy.Engine, Unholy.Types, Unholy.Transform, Unholy.ECS, Unholy.Game, Unholy.Input, Unholy.Project, Unholy.Prefab, Unholy.Physics, Unholy.Audio, Unholy.Application, Unholy.Native, Unholy.Gizmo, Unholy.JSON, Unholy.Script, Unholy.Renderer, Unholy.Renderer.GL, Unholy.Renderer.Assets, Unholy.Renderer.Camera, Unholy.Renderer.GLTF, Unholy.Renderer.IBL, Unholy.Asset.CPU, Unholy.Asset.GLTF, Unholy.Animation, Unholy.Terrain, Unholy.Renderer.Primitives
  other-modules: Unholy.Script.API, Unholy.Editor, Unholy.Theme, Unholy.Exception, Unholy.Resource, Unholy.Asset.GLTF.Internal, Paths_unholy
  autogen-modules: Paths_unholy
  build-depends: base >=4.18 && <5, containers, directory, filepath, process, time, aeson, bytestring, text, deepseq, OpenGLRaw >=3.3 && <3.4, linear >=1.23 && <1.24, vector, hslua-core >=2.3.2 && <2.4
  c-sources: native/hj.c, native/audio.c, native/assets.c, native/hdr.c, native/gltf.c, native/lua.c
  cxx-sources: native/physics.cpp
  cxx-options: -std=c++17
  if os(darwin)
    extra-libraries: c++
    c-sources: native/input_macos.m
    cc-options: -fblocks
    frameworks: Cocoa
  else
    extra-libraries: stdc++
  pkgconfig-depends: raylib >=5.5, bullet >=3
  default-language: Haskell2010
  ghc-options: -Wall -O2

executable unholy
  main-is: Main.hs
  hs-source-dirs: app, examples/pulse-courier/src, examples/circuit-breaker/src, examples/threshold/src
  other-modules: PulseCourier, CircuitBreaker, Threshold
  build-depends: base, unholy, containers
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

test-suite unholy-renderer-tests
  type: exitcode-stdio-1.0
  main-is: RendererSpec.hs
  other-modules: PhysicsSpec, Samples
  hs-source-dirs: test
  build-depends: base, unholy, containers, directory, filepath, vector, linear, OpenGLRaw
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2

executable unholy-bench
  main-is: Main.hs
  hs-source-dirs: bench, examples/pulse-courier/src, examples/circuit-breaker/src, examples/threshold/src
  other-modules: PulseCourier, CircuitBreaker, Threshold
  build-depends: base, unholy, containers, vector, OpenGLRaw
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts -O2

test-suite unholy-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules: Samples, TerrainSpec, AnimationSpec, PhysicsSpec, RuntimeSpec, FeatureSpec, LibrarySpec, ReliabilitySpec, AuthoringSpec
  build-depends: base, unholy, containers, directory, filepath, vector, bytestring, linear
  default-language: Haskell2010
  ghc-options: -Wall -threaded -O2
